{
  "name": "suji",
  "private": true,
  "version": "2.0.3",
  "author": {
    "name": "Rizqi Sani",
    "email": "rizqisani@gmail.com"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:desktop": "npm run build:desktop && electron .",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build:desktop:main": "esbuild electron/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-electron/main.mjs",
    "build:desktop:preload": "esbuild electron/preload.ts --bundle --platform=browser --format=esm --target=es2022 --outfile=dist-electron/preload.mjs",
    "build:desktop": "npm run build:desktop:main && npm run build:desktop:preload && vite build --mode desktop",
    "dist:desktop": "npm run build:desktop && electron-builder --publish never && npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.2.0",
    "docx": "^9.15.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.6.2",
    "express": "^4.21.2",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.3.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "main": "dist-electron/main.mjs",
  "build": {
    "appId": "id.rizqi.suji",
    "productName": "SI-Ujian",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "rizqisani",
        "repo": "suji"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-${os}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Education"
    }
  },
  "allowScripts": {
    "electron@45.3.2": true,
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "minimatch@^9.0.3": "11.0.8",
    "minimatch@^10.0.0": "11.0.8"
  }
}
