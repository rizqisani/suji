# Database and single-owner login configuration for self-hosted deployments.
DATABASE_URL="postgresql://siujian:change-this-password@127.0.0.1:5432/siujian"
APP_USERNAME="admin"
APP_PASSWORD="change-this-to-a-strong-password"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
APP_ENCRYPTION_KEY="replace-with-64-hexadecimal-characters"

# Optional when using an AI gateway configured in the app.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the app is hosted.
APP_URL="MY_APP_URL"
